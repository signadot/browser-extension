{
  "name": "signadot-browser-extension",
  "version": "2.1.0",
  "description": "Signadot browser extension: route your browser's requests to Signadot sandboxes and route groups",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/signadot/browser-extension.git"
  },
  "homepage": "https://chromewebstore.google.com/detail/signadot/aigejiccjejdeiikegdjlofgcjhhnkim",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "lint": "biome ci src",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@blueprintjs/core": "5.7.1",
    "@blueprintjs/select": "5.0.19",
    "@braintree/sanitize-url": "^7.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "react-query": "^3.39.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/chrome": "^0.3.5",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.29",
    "@types/react-dom": "^18.0.11",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "jest": "^30.5.2",
    "rimraf": "^3.0.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.0.4",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.0.0",
    "webpack-merge": "^5.0.0"
  }
}
